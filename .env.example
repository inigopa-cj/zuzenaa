# Copia a .env y ajusta. NO commitear .env.
# Base de datos (usada por docker-compose)
POSTGRES_USER=zuzenaa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zuzenaa

# Backend
ZUZENAA_DEBUG=false
# Raíz de almacenamiento de repos y snapshots (volumen Docker montado en /data)
ZUZENAA_DATA_ROOT=/data
# Clave de servidor (cifra tokens y firma el estado OAuth). Cámbiala en producción.
ZUZENAA_SECRET_KEY=change-me-too
ZUZENAA_BACKEND_URL=http://localhost:8000
ZUZENAA_FRONTEND_URL=http://localhost:8080
# Web de Classroom 50 usada para enlaces profundos (cambiar si es self-hosted)
ZUZENAA_CLASSROOM50_URL=https://classroom50.org

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
# Callback: http://localhost:8000/auth/callback  ·  ver docs/04-autenticacion.md
ZUZENAA_GITHUB_OAUTH_CLIENT_ID=
ZUZENAA_GITHUB_OAUTH_CLIENT_SECRET=

# Agente (proveedor LLM). Por defecto "mock" (sin clave).
ZUZENAA_LLM_PROVIDER=mock
# ZUZENAA_LLM_API_KEY=

# Atajo de desarrollo: usar ZUZENAA_GITHUB_TOKEN si no hay sesión.
ZUZENAA_ALLOW_ENV_TOKEN=false
ZUZENAA_GITHUB_TOKEN=

# --- Datos de prueba (modo demo) ---
# Emula Classroom 50 con un dataset ficticio (org ikastola-demo). NUNCA en producción.
# Guía: docs/06-datos-de-prueba.md
ZUZENAA_DEMO_MODE=false
# Plantilla de la URL de clonado ({org} y {repo}). El modo demo la apunta a orígenes
# git locales: file:///data/demo-origins/{org}/{repo}
# ZUZENAA_GIT_CLONE_URL_TEMPLATE=https://github.com/{org}/{repo}.git

# Puerto local de la web (por defecto 8080). Útil si 8080 está ocupado.
# ZUZENAA_WEB_PORT=8080
